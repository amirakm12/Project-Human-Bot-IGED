// IGED Cyberpunk Shader - Advanced Visual Effects
// Copyright (c) 2024 Project Human Bot

#include "/Engine/Private/Common.ush"
#include "/Engine/Private/ScreenPass.ush"

// Parameters
float Time;
float4 GlowColor;
float GlitchIntensity;
float ScanlineIntensity;
float ChromaticAberration;
float NoiseAmount;
float2 Resolution;

// Utility functions
float random(float2 st) 
{
    return frac(sin(dot(st.xy, float2(12.9898, 78.233))) * 43758.5453123);
}

float noise(float2 st) 
{
    float2 i = floor(st);
    float2 f = frac(st);
    
    float a = random(i);
    float b = random(i + float2(1.0, 0.0));
    float c = random(i + float2(0.0, 1.0));
    float d = random(i + float2(1.0, 1.0));
    
    float2 u = f * f * (3.0 - 2.0 * f);
    
    return lerp(a, b, u.x) + (c - a) * u.y * (1.0 - u.x) + (d - b) * u.x * u.y;
}

// Glitch effect
float3 glitch(float2 uv, float intensity) 
{
    float glitchTime = Time * 10.0;
    float glitchLine = step(0.99, sin(glitchTime * 2.0 + uv.y * 20.0));
    
    float2 glitchUV = uv;
    glitchUV.x += (random(floor(uv.y * 20.0) + glitchTime) - 0.5) * intensity * glitchLine;
    
    return float3(glitchUV, glitchLine);
}

// Scanline effect
float scanlines(float2 uv, float intensity) 
{
    float scanline = sin(uv.y * Resolution.y * 2.0) * 0.04 * intensity;
    return 1.0 - scanline;
}

// Chromatic aberration
float3 chromaticAberration(Texture2D tex, SamplerState samplerTex, float2 uv, float amount) 
{
    float2 offset = amount / Resolution;
    
    float r = Texture2DSample(tex, samplerTex, uv + offset).r;
    float g = Texture2DSample(tex, samplerTex, uv).g;
    float b = Texture2DSample(tex, samplerTex, uv - offset).b;
    
    return float3(r, g, b);
}

// Holographic effect
float3 holographic(float2 uv, float time) 
{
    float3 color = 0;
    
    // Rainbow gradient
    color.r = sin(time * 2.0 + uv.x * 10.0) * 0.5 + 0.5;
    color.g = sin(time * 2.0 + uv.x * 10.0 + 2.094) * 0.5 + 0.5;
    color.b = sin(time * 2.0 + uv.x * 10.0 + 4.188) * 0.5 + 0.5;
    
    // Interference pattern
    float interference = sin(uv.y * 100.0 + time * 5.0) * 0.1 + 0.9;
    color *= interference;
    
    return color;
}

// Data flow visualization
float3 dataFlow(float2 uv, float time) 
{
    float3 color = 0;
    
    // Create flowing data streams
    for (int i = 0; i < 5; i++) 
    {
        float streamPos = frac(time * 0.2 + float(i) * 0.2);
        float streamWidth = 0.01;
        float stream = smoothstep(streamPos - streamWidth, streamPos, uv.y) *
                       smoothstep(streamPos + streamWidth, streamPos, uv.y);
        
        // Add pulse effect
        float pulse = sin(time * 10.0 + float(i) * 2.0) * 0.5 + 0.5;
        stream *= pulse;
        
        // Color based on stream index
        float3 streamColor = float3(
            sin(float(i) * 1.0) * 0.5 + 0.5,
            sin(float(i) * 2.0) * 0.5 + 0.5,
            sin(float(i) * 3.0) * 0.5 + 0.5
        );
        
        color += stream * streamColor * GlowColor.rgb;
    }
    
    return color;
}

// Grid overlay
float3 gridOverlay(float2 uv, float time) 
{
    float gridSize = 0.05;
    float2 grid = step(gridSize, frac(uv * 20.0));
    float gridLine = 1.0 - (grid.x * grid.y);
    
    // Pulse effect
    float pulse = sin(time * 2.0) * 0.2 + 0.8;
    gridLine *= pulse;
    
    return GlowColor.rgb * gridLine * 0.2;
}

// Main pixel shader
void MainPS(
    FScreenVertexOutput Input,
    out float4 OutColor : SV_Target0)
{
    float2 UV = Input.UV;
    
    // Apply glitch effect
    float3 glitchResult = glitch(UV, GlitchIntensity);
    UV = glitchResult.xy;
    
    // Sample base color with chromatic aberration
    float3 baseColor = chromaticAberration(
        PostprocessInput0,
        PostprocessInput0Sampler,
        UV,
        ChromaticAberration
    );
    
    // Apply scanlines
    float scanlineFactor = scanlines(UV, ScanlineIntensity);
    baseColor *= scanlineFactor;
    
    // Add holographic effect
    float3 holo = holographic(UV, Time) * 0.1;
    baseColor += holo;
    
    // Add data flow visualization
    float3 flow = dataFlow(UV, Time) * 0.3;
    baseColor += flow;
    
    // Add grid overlay
    float3 grid = gridOverlay(UV, Time);
    baseColor += grid;
    
    // Add noise
    float noiseVal = noise(UV * 100.0 + Time) * NoiseAmount;
    baseColor += noiseVal;
    
    // Vignette effect
    float2 vignetteUV = UV * (1.0 - UV.yx);
    float vignette = vignetteUV.x * vignetteUV.y * 15.0;
    vignette = pow(vignette, 0.25);
    baseColor *= vignette;
    
    // Color grading for cyberpunk look
    baseColor.r = pow(baseColor.r, 0.8);
    baseColor.g = pow(baseColor.g, 1.1);
    baseColor.b = pow(baseColor.b, 1.3);
    
    // Output
    OutColor = float4(baseColor, 1.0);
}

// Vertex shader
void MainVS(
    in float4 InPosition : ATTRIBUTE0,
    in float2 InTexCoord : ATTRIBUTE1,
    out FScreenVertexOutput Output)
{
    DrawRectangle(InPosition, InTexCoord, Output.Position, Output.UV);
}
